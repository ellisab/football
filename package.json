{
  "name": "footballleagues",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "next dev",
    "build": "pnpm run lint && pnpm run typecheck && next build",
    "start": "next start",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "test": "pnpm exec tsx --test \"src/**/*.test.ts\" && pnpm -C packages/core test",
    "typecheck": "next typegen && touch .next/types/cache-life.d.ts && tsc --noEmit"
  },
  "dependencies": {
    "@footballleagues/core": "workspace:*",
    "@footballleagues/ui": "workspace:*",
    "@vercel/analytics": "^2.0.1",
    "lucide-react": "^1.44.0",
    "next": "16.3.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
